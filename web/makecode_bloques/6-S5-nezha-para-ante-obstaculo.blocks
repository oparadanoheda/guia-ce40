<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="device_forever" x="20" y="20"><statement name="HANDLER"><block type="controls_if"><mutation else="1"></mutation><comment pinned="false" h="80" w="160">Sensor de ultrasonidos en el puerto J1</comment><value name="IF0"><shadow type="logic_boolean"><field name="BOOL">TRUE</field></shadow><block type="logic_compare"><field name="OP">LT</field><value name="A"><shadow type="math_number"><field name="NUM">0</field></shadow><block type="sonarbit"><field name="Rjpin">PlanetX_Basic.DigitalRJPin.J1</field><field name="distance_unit">PlanetX_Basic.Distance_Unit_List.Distance_Unit_cm</field></block></value><value name="B"><shadow type="math_number"><field name="NUM">10</field></shadow></value></block></value><statement name="DO0"><block type="stopAllMotor"></block></statement><statement name="ELSE"><block type="setMotorSpeed"><field name="motor">neZha.MotorList.M1</field><value name="speed"><shadow type="math_number_minmax"><mutation min="-100" max="100" label="Speed" precision="0"></mutation><field name="SLIDER">30</field></shadow></value><next><block type="setMotorSpeed"><field name="motor">neZha.MotorList.M2</field><value name="speed"><shadow type="math_number_minmax"><mutation min="-100" max="100" label="Speed" precision="0"></mutation><field name="SLIDER">-30</field></shadow></value></block></next></block></statement></block></statement></block></xml>