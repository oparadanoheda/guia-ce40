  "name": "5\u00ba S8 \u00b7 El Nezha avanza 1 segundo"
 },
 "source": "{\"pxt.json\": \"{\\n    \\\"name\\\": \\\"5\u00ba S8 \u00b7 El Nezha avanza 1 segundo\\\",\\n    \\\"description\\\": \\\"Gu\u00eda C\u00f3digo Escuela 4.0 \u00b7 5\u00ba S8\\\",\\n    \\\"dependencies\\\": {\\n        \\\"core\\\": \\\"*\\\",\\n        \\\"radio\\\": \\\"*\\\",\\n        \\\"microphone\\\": \\\"*\\\",\\n        \\\"pxt-nezha\\\": \\\"github:elecfreaks/pxt-nezha#v1.3.9\\\"\\n    },\\n    \\\"files\\\": [\\n        \\\"main.blocks\\\",\\n        \\\"main.ts\\\",\\n        \\\"README.md\\\"\\n    ],\\n    \\\"preferredEditor\\\": \\\"blocksprj\\\"\\n}\", \"main.blocks\": \"<xml xmlns=\\\"https://developers.google.com/blockly/xml\\\"><variables></variables><block type=\\\"device_button_event\\\" x=\\\"20\\\" y=\\\"20\\\"><field name=\\\"NAME\\\">Button.A</field><statement name=\\\"HANDLER\\\"><block type=\\\"setMotorSpeed\\\"><field name=\\\"motor\\\">neZha.MotorList.M1</field><comment pinned=\\\"false\\\" h=\\\"80\\\" w=\\\"160\\\">Los dos motores van en espejo: para ir recto, M1 en positivo y M2 en negativo.\\nSi el coche gira en vez de avanzar, cambia el signo de M2.</comment><value name=\\\"speed\\\"><shadow type=\\\"math_number_minmax\\\"><mutation min=\\\"-100\\\" max=\\\"100\\\" label=\\\"Speed\\\" precision=\\\"0\\\"></mutation><field name=\\\"SLIDER\\\">50</field></shadow></value><next><block type=\\\"setMotorSpeed\\\"><field name=\\\"motor\\\">neZha.MotorList.M2</field><value name=\\\"speed\\\"><shadow type=\\\"math_number_minmax\\\"><mutation min=\\\"-100\\\" max=\\\"100\\\" label=\\\"Speed\\\" precision=\\\"0\\\"></mutation><field name=\\\"SLIDER\\\">-50</field></shadow></value><next><block type=\\\"device_pause\\\"><value name=\\\"pause\\\"><shadow type=\\\"timePicker\\\"><field name=\\\"ms\\\">1000</field></shadow></value><next><block type=\\\"stopAllMotor\\\"></block></next></block></next></block></next></block></statement></block></xml>\", \"main.ts\": \"input.onButtonPressed(Button.A, function () {\\n    // Los dos motores van en espejo: para ir recto, M1 en positivo y M2 en negativo.\\n    // Si el coche gira en vez de avanzar, cambia el signo de M2.\\n    neZha.setMotorSpeed(neZha.MotorList.M1, 50)\\n    neZha.setMotorSpeed(neZha.MotorList.M2, -50)\\n    basic.pause(1000)\\n    neZha.stopAllMotor()\\n})\\n\", \"README.md\": \"# 5\u00ba S8 \u00b7 El Nezha avanza 1 segundo\\n\\nGu\u00eda did\u00e1ctica C\u00f3digo Escuela 4.0 \u00b7 5\u00ba S8. Programa de referencia para el docente.\\n\"}"
}