 "source": "{\"pxt.json\": \"{\\n    \\\"name\\\": \\\"5\u00ba S16 \u00b7 Radio entre dos placas\\\",\\n    \\\"description\\\": \\\"Gu\u00eda C\u00f3digo Escuela 4.0 \u00b7 5\u00ba S16\\\",\\n    \\\"dependencies\\\": {\\n        \\\"core\\\": \\\"*\\\",\\n        \\\"radio\\\": \\\"*\\\",\\n        \\\"microphone\\\": \\\"*\\\"\\n    },\\n    \\\"files\\\": [\\n        \\\"main.blocks\\\",\\n        \\\"main.ts\\\",\\n        \\\"README.md\\\"\\n    ],\\n    \\\"preferredEditor\\\": \\\"blocksprj\\\"\\n}\", \"main.blocks\": \"<xml xmlns=\\\"https://developers.google.com/blockly/xml\\\"><variables></variables><block type=\\\"pxt-on-start\\\" x=\\\"20\\\" y=\\\"20\\\"><statement name=\\\"HANDLER\\\"><block type=\\\"radio_set_group\\\"><comment pinned=\\\"false\\\" h=\\\"80\\\" w=\\\"160\\\">Las dos placas, con el mismo programa y el mismo grupo</comment><value name=\\\"ID\\\"><shadow type=\\\"math_number_minmax\\\"><mutation min=\\\"0\\\" max=\\\"255\\\" label=\\\"Id\\\" precision=\\\"0\\\"></mutation><field name=\\\"SLIDER\\\">7</field></shadow></value></block></statement></block><block type=\\\"device_button_event\\\" x=\\\"368\\\" y=\\\"20\\\"><field name=\\\"NAME\\\">Button.A</field><statement name=\\\"HANDLER\\\"><block type=\\\"radio_datagram_send\\\"><value name=\\\"value\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">1</field></shadow></value></block></statement></block><block type=\\\"radio_on_number_drag\\\" x=\\\"20\\\" y=\\\"193\\\"><value name=\\\"HANDLER_DRAG_PARAM_receivedNumber\\\"><block type=\\\"argument_reporter_number\\\" deletable=\\\"false\\\"><field name=\\\"VALUE\\\">receivedNumber</field></block></value><statement name=\\\"HANDLER\\\"><block type=\\\"device_show_number\\\"><value name=\\\"number\\\"><block type=\\\"argument_reporter_number\\\"><field name=\\\"VALUE\\\">receivedNumber</field></block></value></block></statement></block></xml>\", \"main.ts\": \"input.onButtonPressed(Button.A, function () {\\n    radio.sendNumber(1)\\n})\\nradio.onReceivedNumber(function (receivedNumber) {\\n    basic.showNumber(receivedNumber)\\n})\\n// Las dos placas, con el mismo programa y el mismo grupo\\nradio.setGroup(7)\\n\", \"README.md\": \"# 5\u00ba S16 \u00b7 Radio entre dos placas\\n\\nGu\u00eda did\u00e1ctica C\u00f3digo Escuela 4.0 \u00b7 5\u00ba S16. Programa de referencia para el docente.\\n\"}"
}