 "source": "{\"pxt.json\": \"{\\n    \\\"name\\\": \\\"5\u00ba S6 \u00b7 Bicho 2: el contador\\\",\\n    \\\"description\\\": \\\"Gu\u00eda C\u00f3digo Escuela 4.0 \u00b7 5\u00ba S6\\\",\\n    \\\"dependencies\\\": {\\n        \\\"core\\\": \\\"*\\\",\\n        \\\"radio\\\": \\\"*\\\",\\n        \\\"microphone\\\": \\\"*\\\"\\n    },\\n    \\\"files\\\": [\\n        \\\"main.blocks\\\",\\n        \\\"main.ts\\\",\\n        \\\"README.md\\\"\\n    ],\\n    \\\"preferredEditor\\\": \\\"blocksprj\\\"\\n}\", \"main.blocks\": \"<xml xmlns=\\\"https://developers.google.com/blockly/xml\\\"><variables><variable id=\\\"1wSF1;?r?^B{RDp@Bmw!\\\">contador</variable></variables><block type=\\\"pxt-on-start\\\" x=\\\"20\\\" y=\\\"20\\\"><statement name=\\\"HANDLER\\\"><block type=\\\"device_show_number\\\"><value name=\\\"number\\\"><block type=\\\"variables_get\\\"><field name=\\\"VAR\\\" id=\\\"1wSF1;?r?^B{RDp@Bmw!\\\">contador</field></block></value></block></statement></block><block type=\\\"device_button_event\\\" x=\\\"346\\\" y=\\\"20\\\"><field name=\\\"NAME\\\">Button.A</field><statement name=\\\"HANDLER\\\"><block type=\\\"variables_change\\\"><field name=\\\"VAR\\\" id=\\\"1wSF1;?r?^B{RDp@Bmw!\\\">contador</field><value name=\\\"VALUE\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">1</field></shadow></value></block></statement></block></xml>\", \"main.ts\": \"let contador = 0\\ninput.onButtonPressed(Button.A, function () {\\n    contador += 1\\n})\\nbasic.showNumber(contador)\\n\", \"README.md\": \"# 5\u00ba S6 \u00b7 Bicho 2: el contador\\n\\nGu\u00eda did\u00e1ctica C\u00f3digo Escuela 4.0 \u00b7 5\u00ba S6. Programa de referencia para el docente.\\n\"}"
