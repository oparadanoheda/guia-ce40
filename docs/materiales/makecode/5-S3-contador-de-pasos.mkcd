 "source": "{\"pxt.json\": \"{\\n    \\\"name\\\": \\\"5\u00ba S3 \u00b7 Contador de pasos\\\",\\n    \\\"description\\\": \\\"Gu\u00eda C\u00f3digo Escuela 4.0 \u00b7 5\u00ba S3\\\",\\n    \\\"dependencies\\\": {\\n        \\\"core\\\": \\\"*\\\",\\n        \\\"radio\\\": \\\"*\\\",\\n        \\\"microphone\\\": \\\"*\\\"\\n    },\\n    \\\"files\\\": [\\n        \\\"main.blocks\\\",\\n        \\\"main.ts\\\",\\n        \\\"README.md\\\"\\n    ],\\n    \\\"preferredEditor\\\": \\\"blocksprj\\\"\\n}\", \"main.blocks\": \"<xml xmlns=\\\"https://developers.google.com/blockly/xml\\\"><variables><variable id=\\\"xKf:+crGsk*9N~N}g^;3\\\">pasos</variable></variables><block type=\\\"device_button_event\\\" x=\\\"20\\\" y=\\\"20\\\"><field name=\\\"NAME\\\">Button.A</field><statement name=\\\"HANDLER\\\"><block type=\\\"variables_set\\\"><field name=\\\"VAR\\\" id=\\\"xKf:+crGsk*9N~N}g^;3\\\">pasos</field><value name=\\\"VALUE\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">0</field></shadow></value><next><block type=\\\"device_show_number\\\"><value name=\\\"number\\\"><block type=\\\"variables_get\\\"><field name=\\\"VAR\\\" id=\\\"xKf:+crGsk*9N~N}g^;3\\\">pasos</field></block></value></block></next></block></statement></block><block type=\\\"device_gesture_event\\\" x=\\\"341\\\" y=\\\"20\\\"><field name=\\\"NAME\\\">Gesture.Shake</field><statement name=\\\"HANDLER\\\"><block type=\\\"variables_change\\\"><field name=\\\"VAR\\\" id=\\\"xKf:+crGsk*9N~N}g^;3\\\">pasos</field><value name=\\\"VALUE\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">1</field></shadow></value><next><block type=\\\"device_show_number\\\"><value name=\\\"number\\\"><block type=\\\"variables_get\\\"><field name=\\\"VAR\\\" id=\\\"xKf:+crGsk*9N~N}g^;3\\\">pasos</field></block></value></block></next></block></statement></block></xml>\", \"main.ts\": \"let pasos = 0\\ninput.onGesture(Gesture.Shake, function () {\\n    pasos += 1\\n    basic.showNumber(pasos)\\n})\\ninput.onButtonPressed(Button.A, function () {\\n    pasos = 0\\n    basic.showNumber(pasos)\\n})\\n\", \"README.md\": \"# 5\u00ba S3 \u00b7 Contador de pasos\\n\\nGu\u00eda did\u00e1ctica C\u00f3digo Escuela 4.0 \u00b7 5\u00ba S3. Programa de referencia para el docente.\\n\"}"
}