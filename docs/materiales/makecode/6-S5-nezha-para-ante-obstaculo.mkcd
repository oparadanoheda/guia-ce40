  "name": "6\u00ba S5 \u00b7 El Nezha para ante un obst\u00e1culo"
 },
 "source": "{\"pxt.json\": \"{\\n    \\\"name\\\": \\\"6\u00ba S5 \u00b7 El Nezha para ante un obst\u00e1culo\\\",\\n    \\\"description\\\": \\\"Gu\u00eda C\u00f3digo Escuela 4.0 \u00b7 6\u00ba S5\\\",\\n    \\\"dependencies\\\": {\\n        \\\"core\\\": \\\"*\\\",\\n        \\\"radio\\\": \\\"*\\\",\\n        \\\"microphone\\\": \\\"*\\\",\\n        \\\"pxt-nezha\\\": \\\"github:elecfreaks/pxt-nezha#v1.3.9\\\",\\n        \\\"pxt-PlanetX\\\": \\\"github:elecfreaks/pxt-planetx#v1.5.33\\\"\\n    },\\n    \\\"files\\\": [\\n        \\\"main.blocks\\\",\\n        \\\"main.ts\\\",\\n        \\\"README.md\\\"\\n    ],\\n    \\\"preferredEditor\\\": \\\"blocksprj\\\"\\n}\", \"main.blocks\": \"<xml xmlns=\\\"https://developers.google.com/blockly/xml\\\"><variables></variables><block type=\\\"device_forever\\\" x=\\\"20\\\" y=\\\"20\\\"><statement name=\\\"HANDLER\\\"><block type=\\\"controls_if\\\"><mutation else=\\\"1\\\"></mutation><comment pinned=\\\"false\\\" h=\\\"80\\\" w=\\\"160\\\">Sensor de ultrasonidos en el puerto J1</comment><value name=\\\"IF0\\\"><shadow type=\\\"logic_boolean\\\"><field name=\\\"BOOL\\\">TRUE</field></shadow><block type=\\\"logic_compare\\\"><field name=\\\"OP\\\">LT</field><value name=\\\"A\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">0</field></shadow><block type=\\\"sonarbit\\\"><field name=\\\"Rjpin\\\">PlanetX_Basic.DigitalRJPin.J1</field><field name=\\\"distance_unit\\\">PlanetX_Basic.Distance_Unit_List.Distance_Unit_cm</field></block></value><value name=\\\"B\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">10</field></shadow></value></block></value><statement name=\\\"DO0\\\"><block type=\\\"stopAllMotor\\\"></block></statement><statement name=\\\"ELSE\\\"><block type=\\\"setMotorSpeed\\\"><field name=\\\"motor\\\">neZha.MotorList.M1</field><value name=\\\"speed\\\"><shadow type=\\\"math_number_minmax\\\"><mutation min=\\\"-100\\\" max=\\\"100\\\" label=\\\"Speed\\\" precision=\\\"0\\\"></mutation><field name=\\\"SLIDER\\\">30</field></shadow></value><next><block type=\\\"setMotorSpeed\\\"><field name=\\\"motor\\\">neZha.MotorList.M2</field><value name=\\\"speed\\\"><shadow type=\\\"math_number_minmax\\\"><mutation min=\\\"-100\\\" max=\\\"100\\\" label=\\\"Speed\\\" precision=\\\"0\\\"></mutation><field name=\\\"SLIDER\\\">-30</field></shadow></value></block></next></block></statement></block></statement></block></xml>\", \"main.ts\": \"basic.forever(function () {\\n    // Sensor de ultrasonidos en el puerto J1\\n    if (PlanetX_Basic.ultrasoundSensor(PlanetX_Basic.DigitalRJPin.J1, PlanetX_Basic.Distance_Unit_List.Distance_Unit_cm) < 10) {\\n        neZha.stopAllMotor()\\n    } else {\\n        neZha.setMotorSpeed(neZha.MotorList.M1, 30)\\n        neZha.setMotorSpeed(neZha.MotorList.M2, -30)\\n    }\\n})\\n\", \"README.md\": \"# 6\u00ba S5 \u00b7 El Nezha para ante un obst\u00e1culo\\n\\nGu\u00eda did\u00e1ctica C\u00f3digo Escuela 4.0 \u00b7 6\u00ba S5. Programa de referencia para el docente.\\n\"}"
}