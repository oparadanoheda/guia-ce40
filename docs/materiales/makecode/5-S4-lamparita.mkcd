 "source": "{\"pxt.json\": \"{\\n    \\\"name\\\": \\\"5\u00ba S4 \u00b7 Lamparita de noche\\\",\\n    \\\"description\\\": \\\"Gu\u00eda C\u00f3digo Escuela 4.0 \u00b7 5\u00ba S4\\\",\\n    \\\"dependencies\\\": {\\n        \\\"core\\\": \\\"*\\\",\\n        \\\"radio\\\": \\\"*\\\",\\n        \\\"microphone\\\": \\\"*\\\"\\n    },\\n    \\\"files\\\": [\\n        \\\"main.blocks\\\",\\n        \\\"main.ts\\\",\\n        \\\"README.md\\\"\\n    ],\\n    \\\"preferredEditor\\\": \\\"blocksprj\\\"\\n}\", \"main.blocks\": \"<xml xmlns=\\\"https://developers.google.com/blockly/xml\\\"><variables></variables><block type=\\\"device_forever\\\" x=\\\"20\\\" y=\\\"20\\\"><statement name=\\\"HANDLER\\\"><block type=\\\"controls_if\\\"><mutation else=\\\"1\\\"></mutation><comment pinned=\\\"false\\\" h=\\\"80\\\" w=\\\"160\\\">El umbral (50) se ajusta midiendo la luz de la clase</comment><value name=\\\"IF0\\\"><shadow type=\\\"logic_boolean\\\"><field name=\\\"BOOL\\\">TRUE</field></shadow><block type=\\\"logic_compare\\\"><field name=\\\"OP\\\">LT</field><value name=\\\"A\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">0</field></shadow><block type=\\\"device_get_light_level\\\"></block></value><value name=\\\"B\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">50</field></shadow></value></block></value><statement name=\\\"DO0\\\"><block type=\\\"device_show_leds\\\"><field name=\\\"LEDS\\\">`\\n        # # # # # \\n        # # # # # \\n        # # # # # \\n        # # # # # \\n        # # # # #\\n        `</field></block></statement><statement name=\\\"ELSE\\\"><block type=\\\"device_clear_display\\\"></block></statement></block></statement></block></xml>\", \"main.ts\": \"basic.forever(function () {\\n    // El umbral (50) se ajusta midiendo la luz de la clase\\n    if (input.lightLevel() < 50) {\\n        basic.showLeds(`\\n            # # # # #\\n            # # # # #\\n            # # # # #\\n            # # # # #\\n            # # # # #\\n            `)\\n    } else {\\n        basic.clearScreen()\\n    }\\n})\\n\", \"README.md\": \"# 5\u00ba S4 \u00b7 Lamparita de noche\\n\\nGu\u00eda did\u00e1ctica C\u00f3digo Escuela 4.0 \u00b7 5\u00ba S4. Programa de referencia para el docente.\\n\"}"
