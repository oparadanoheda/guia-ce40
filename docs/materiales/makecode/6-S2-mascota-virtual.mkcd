  "name": "6\u00ba S2 \u00b7 La mascota virtual"
 },
 "source": "{\"pxt.json\": \"{\\n    \\\"name\\\": \\\"6\u00ba S2 \u00b7 La mascota virtual\\\",\\n    \\\"description\\\": \\\"Gu\u00eda C\u00f3digo Escuela 4.0 \u00b7 6\u00ba S2\\\",\\n    \\\"dependencies\\\": {\\n        \\\"core\\\": \\\"*\\\",\\n        \\\"radio\\\": \\\"*\\\",\\n        \\\"microphone\\\": \\\"*\\\"\\n    },\\n    \\\"files\\\": [\\n        \\\"main.blocks\\\",\\n        \\\"main.ts\\\",\\n        \\\"README.md\\\"\\n    ],\\n    \\\"preferredEditor\\\": \\\"blocksprj\\\"\\n}\", \"main.blocks\": \"<xml xmlns=\\\"https://developers.google.com/blockly/xml\\\"><variables><variable id=\\\";c:k=vS}M-N,cTHK/tA.\\\">hambre</variable></variables><block type=\\\"pxt-on-start\\\" x=\\\"20\\\" y=\\\"20\\\"><statement name=\\\"HANDLER\\\"><block type=\\\"variables_set\\\"><field name=\\\"VAR\\\" id=\\\";c:k=vS}M-N,cTHK/tA.\\\">hambre</field><value name=\\\"VALUE\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">5</field></shadow></value></block></statement></block><block type=\\\"device_button_event\\\" x=\\\"305\\\" y=\\\"20\\\"><field name=\\\"NAME\\\">Button.A</field><statement name=\\\"HANDLER\\\"><block type=\\\"controls_if\\\"><value name=\\\"IF0\\\"><shadow type=\\\"logic_boolean\\\"><field name=\\\"BOOL\\\">TRUE</field></shadow><block type=\\\"logic_compare\\\"><field name=\\\"OP\\\">GT</field><value name=\\\"A\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">0</field></shadow><block type=\\\"variables_get\\\"><field name=\\\"VAR\\\" id=\\\";c:k=vS}M-N,cTHK/tA.\\\">hambre</field></block></value><value name=\\\"B\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">0</field></shadow></value></block></value><statement name=\\\"DO0\\\"><block type=\\\"variables_change\\\"><field name=\\\"VAR\\\" id=\\\";c:k=vS}M-N,cTHK/tA.\\\">hambre</field><value name=\\\"VALUE\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">-1</field></shadow></value></block></statement><next><block type=\\\"basic_show_icon\\\"><field name=\\\"i\\\">IconNames.Happy</field></block></next></block></statement></block><block type=\\\"device_button_event\\\" x=\\\"749\\\" y=\\\"20\\\"><field name=\\\"NAME\\\">Button.B</field><statement name=\\\"HANDLER\\\"><block type=\\\"device_show_number\\\"><value name=\\\"number\\\"><block type=\\\"variables_get\\\"><field name=\\\"VAR\\\" id=\\\";c:k=vS}M-N,cTHK/tA.\\\">hambre</field></block></value></block></statement></block><block type=\\\"device_button_event\\\" x=\\\"1070\\\" y=\\\"20\\\"><field name=\\\"NAME\\\">Button.AB</field><statement name=\\\"HANDLER\\\"><block type=\\\"music_playable_play\\\"><field name=\\\"playbackMode\\\">music.PlaybackMode.UntilDone</field><value name=\\\"toPlay\\\"><shadow type=\\\"music_string_playable\\\"><value name=\\\"melody\\\"><shadow type=\\\"melody_editor\\\"><field name=\\\"melody\\\">\\\"C D E F G F E D \\\"</field></shadow></value><value name=\\\"bpm\\\"><shadow type=\\\"math_number_minmax\\\"><mutation min=\\\"40\\\" max=\\\"500\\\" label=\\\"Bpm\\\" precision=\\\"0\\\"></mutation><field name=\\\"SLIDER\\\">120</field></shadow></value></shadow></value></block></statement></block><block type=\\\"device_forever\\\" x=\\\"20\\\" y=\\\"343\\\"><statement name=\\\"HANDLER\\\"><block type=\\\"device_pause\\\"><value name=\\\"pause\\\"><shadow type=\\\"timePicker\\\"><field name=\\\"ms\\\">10000</field></shadow></value><next><block type=\\\"variables_change\\\"><field name=\\\"VAR\\\" id=\\\";c:k=vS}M-N,cTHK/tA.\\\">hambre</field><value name=\\\"VALUE\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">1</field></shadow></value><next><block type=\\\"controls_if\\\"><value name=\\\"IF0\\\"><shadow type=\\\"logic_boolean\\\"><field name=\\\"BOOL\\\">TRUE</field></shadow><block type=\\\"logic_compare\\\"><field name=\\\"OP\\\">GT</field><value name=\\\"A\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">0</field></shadow><block type=\\\"variables_get\\\"><field name=\\\"VAR\\\" id=\\\";c:k=vS}M-N,cTHK/tA.\\\">hambre</field></block></value><value name=\\\"B\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">8</field></shadow></value></block></value><statement name=\\\"DO0\\\"><block type=\\\"basic_show_icon\\\"><field name=\\\"i\\\">IconNames.Sad</field></block></statement></block></next></block></next></block></statement></block><block type=\\\"device_gesture_event\\\" x=\\\"464\\\" y=\\\"343\\\"><field name=\\\"NAME\\\">Gesture.Shake</field><statement name=\\\"HANDLER\\\"><block type=\\\"basic_show_icon\\\"><field name=\\\"i\\\">IconNames.Silly</field><next><block type=\\\"variables_change\\\"><field name=\\\"VAR\\\" id=\\\";c:k=vS}M-N,cTHK/tA.\\\">hambre</field><value name=\\\"VALUE\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">1</field></shadow></value></block></next></block></statement></block></xml>\", \"main.ts\": \"let hambre = 5\\ninput.onButtonPressed(Button.A, function () {\\n    if (hambre > 0) {\\n        hambre += -1\\n    }\\n    basic.showIcon(IconNames.Happy)\\n})\\ninput.onButtonPressed(Button.B, function () {\\n    basic.showNumber(hambre)\\n})\\ninput.onGesture(Gesture.Shake, function () {\\n    basic.showIcon(IconNames.Silly)\\n    hambre += 1\\n})\\ninput.onButtonPressed(Button.AB, function () {\\n    music.play(music.stringPlayable(\\\"C D E F G F E D \\\", 120), music.PlaybackMode.UntilDone)\\n})\\nbasic.forever(function () {\\n    basic.pause(10000)\\n    hambre += 1\\n    if (hambre > 8) {\\n        basic.showIcon(IconNames.Sad)\\n    }\\n})\\n\", \"README.md\": \"# 6\u00ba S2 \u00b7 La mascota virtual\\n\\nGu\u00eda did\u00e1ctica C\u00f3digo Escuela 4.0 \u00b7 6\u00ba S2. Programa de referencia para el docente.\\n\"}"
}