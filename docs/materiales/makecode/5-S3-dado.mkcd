  "name": "5\u00ba S3 \u00b7 El dado electr\u00f3nico"
 },
 "source": "{\"pxt.json\": \"{\\n    \\\"name\\\": \\\"5\u00ba S3 \u00b7 El dado electr\u00f3nico\\\",\\n    \\\"description\\\": \\\"Gu\u00eda C\u00f3digo Escuela 4.0 \u00b7 5\u00ba S3\\\",\\n    \\\"dependencies\\\": {\\n        \\\"core\\\": \\\"*\\\",\\n        \\\"radio\\\": \\\"*\\\",\\n        \\\"microphone\\\": \\\"*\\\"\\n    },\\n    \\\"files\\\": [\\n        \\\"main.blocks\\\",\\n        \\\"main.ts\\\",\\n        \\\"README.md\\\"\\n    ],\\n    \\\"preferredEditor\\\": \\\"blocksprj\\\"\\n}\", \"main.blocks\": \"<xml xmlns=\\\"https://developers.google.com/blockly/xml\\\"><variables></variables><block type=\\\"device_gesture_event\\\" x=\\\"20\\\" y=\\\"20\\\"><field name=\\\"NAME\\\">Gesture.Shake</field><statement name=\\\"HANDLER\\\"><block type=\\\"basic_show_icon\\\"><field name=\\\"i\\\">IconNames.SmallSquare</field><comment pinned=\\\"false\\\" h=\\\"80\\\" w=\\\"160\\\">La animaci\u00f3n antes del n\u00famero</comment><next><block type=\\\"basic_show_icon\\\"><field name=\\\"i\\\">IconNames.Square</field><next><block type=\\\"device_show_number\\\"><value name=\\\"number\\\"><block type=\\\"device_random\\\"><value name=\\\"min\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">1</field></shadow></value><value name=\\\"limit\\\"><shadow type=\\\"math_number\\\"><field name=\\\"NUM\\\">6</field></shadow></value></block></value></block></next></block></next></block></statement></block></xml>\", \"main.ts\": \"input.onGesture(Gesture.Shake, function () {\\n    // La animaci\u00f3n antes del n\u00famero\\n    basic.showIcon(IconNames.SmallSquare)\\n    basic.showIcon(IconNames.Square)\\n    basic.showNumber(randint(1, 6))\\n})\\n\", \"README.md\": \"# 5\u00ba S3 \u00b7 El dado electr\u00f3nico\\n\\nGu\u00eda did\u00e1ctica C\u00f3digo Escuela 4.0 \u00b7 5\u00ba S3. Programa de referencia para el docente.\\n\"}"
}