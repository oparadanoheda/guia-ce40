 "source": "{\"pxt.json\": \"{\\n    \\\"name\\\": \\\"6\u00ba S5 \u00b7 Tres eventos, tres comportamientos\\\",\\n    \\\"description\\\": \\\"Gu\u00eda C\u00f3digo Escuela 4.0 \u00b7 6\u00ba S5\\\",\\n    \\\"dependencies\\\": {\\n        \\\"core\\\": \\\"*\\\",\\n        \\\"radio\\\": \\\"*\\\",\\n        \\\"microphone\\\": \\\"*\\\",\\n        \\\"pxt-nezha\\\": \\\"github:elecfreaks/pxt-nezha#v1.3.9\\\"\\n    },\\n    \\\"files\\\": [\\n        \\\"main.blocks\\\",\\n        \\\"main.ts\\\",\\n        \\\"README.md\\\"\\n    ],\\n    \\\"preferredEditor\\\": \\\"blocksprj\\\"\\n}\", \"main.blocks\": \"<xml xmlns=\\\"https://developers.google.com/blockly/xml\\\"><variables></variables><block type=\\\"device_button_event\\\" x=\\\"20\\\" y=\\\"20\\\"><field name=\\\"NAME\\\">Button.A</field><statement name=\\\"HANDLER\\\"><block type=\\\"setMotorSpeed\\\"><field name=\\\"motor\\\">neZha.MotorList.M1</field><value name=\\\"speed\\\"><shadow type=\\\"math_number_minmax\\\"><mutation min=\\\"-100\\\" max=\\\"100\\\" label=\\\"Speed\\\" precision=\\\"0\\\"></mutation><field name=\\\"SLIDER\\\">50</field></shadow></value><next><block type=\\\"setMotorSpeed\\\"><field name=\\\"motor\\\">neZha.MotorList.M2</field><value name=\\\"speed\\\"><shadow type=\\\"math_number_minmax\\\"><mutation min=\\\"-100\\\" max=\\\"100\\\" label=\\\"Speed\\\" precision=\\\"0\\\"></mutation><field name=\\\"SLIDER\\\">-50</field></shadow></value></block></next></block></statement></block><block type=\\\"device_button_event\\\" x=\\\"396\\\" y=\\\"20\\\"><field name=\\\"NAME\\\">Button.B</field><statement name=\\\"HANDLER\\\"><block type=\\\"stopAllMotor\\\"></block></statement></block><block type=\\\"device_button_event\\\" x=\\\"20\\\" y=\\\"241\\\"><field name=\\\"NAME\\\">Button.AB</field><statement name=\\\"HANDLER\\\"><block type=\\\"setMotorSpeed\\\"><field name=\\\"motor\\\">neZha.MotorList.M1</field><value name=\\\"speed\\\"><shadow type=\\\"math_number_minmax\\\"><mutation min=\\\"-100\\\" max=\\\"100\\\" label=\\\"Speed\\\" precision=\\\"0\\\"></mutation><field name=\\\"SLIDER\\\">50</field></shadow></value><next><block type=\\\"setMotorSpeed\\\"><field name=\\\"motor\\\">neZha.MotorList.M2</field><value name=\\\"speed\\\"><shadow type=\\\"math_number_minmax\\\"><mutation min=\\\"-100\\\" max=\\\"100\\\" label=\\\"Speed\\\" precision=\\\"0\\\"></mutation><field name=\\\"SLIDER\\\">50</field></shadow></value></block></next></block></statement></block></xml>\", \"main.ts\": \"input.onButtonPressed(Button.A, function () {\\n    neZha.setMotorSpeed(neZha.MotorList.M1, 50)\\n    neZha.setMotorSpeed(neZha.MotorList.M2, -50)\\n})\\ninput.onButtonPressed(Button.B, function () {\\n    neZha.stopAllMotor()\\n})\\ninput.onButtonPressed(Button.AB, function () {\\n    neZha.setMotorSpeed(neZha.MotorList.M1, 50)\\n    neZha.setMotorSpeed(neZha.MotorList.M2, 50)\\n})\\n\", \"README.md\": \"# 6\u00ba S5 \u00b7 Tres eventos, tres comportamientos\\n\\nGu\u00eda did\u00e1ctica C\u00f3digo Escuela 4.0 \u00b7 6\u00ba S5. Programa de referencia para el docente.\\n\"}"
}